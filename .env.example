# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://hastra_user:CHANGE_ME@localhost:5432/hastra
API_HOST=0.0.0.0
API_PORT=8000
# Set to your machine's LAN IP so the Expo app on a physical device can reach the backend
API_BASE_URL=http://192.168.x.x:8000
LOG_LEVEL=info
